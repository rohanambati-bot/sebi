{
  "manifest_version": 3,
  "name": "SentinelSEBI — Investor Protection Shield",
  "version": "1.2.0",
  "description": "Real-time AI-driven investor protection shield for webmail, WhatsApp, Telegram, and financial forums. Automatically flags scams, sets dynamic risk badges, and logs evidence to SEBI database.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.onrender.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentinelSEBI Investor Protection Shield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    }
  ]
}
